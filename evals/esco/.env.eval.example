# Copy to the repository root as .env.eval. Never commit the populated file.
# Alternatively, inject these names through the cloud environment settings.
SUPABASE_URL=https://ywhtjwawnkeqlwxbvgup.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# Set the exact Claude Sonnet model ID shown in the OpenRouter model catalog.
# The user selected Claude Sonnet; do not silently substitute another family.
JUEZ_MODELO=
# Optional: separate key or an OpenAI-compatible judge endpoint.
# JUEZ_API_KEY=
# JUEZ_BASE_URL=https://openrouter.ai/api/v1

# No network calls by default. Use originales to calibrate, live to run Esco.
EVAL_MODO=plan
# Explicitly enable deterministic-only scoring when no judge is desired.
# EVAL_SIN_JUEZ=1
